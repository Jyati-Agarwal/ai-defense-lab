{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2SingleHostDeploy",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages", "ec2:DescribeInstances", "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypes", "ec2:DescribeSecurityGroups", "ec2:DescribeVpcs",
        "ec2:DescribeSubnets", "ec2:DescribeAvailabilityZones", "ec2:DescribeTags",
        "ec2:CreateSecurityGroup", "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RunInstances", "ec2:CreateTags",
        "ec2:StartInstances", "ec2:StopInstances", "ec2:TerminateInstances",
        "ec2:DescribeIamInstanceProfileAssociations", "ec2:GetConsoleOutput"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InstanceRoleForEcrPull",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:GetRole", "iam:AttachRolePolicy", "iam:ListAttachedRolePolicies",
        "iam:CreateInstanceProfile", "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile", "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ai-defense-lab-ec2",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:instance-profile/ai-defense-lab-ec2"
      ]
    },
    {
      "Sid": "BudgetGuardrail",
      "Effect": "Allow",
      "Action": ["budgets:CreateBudget", "budgets:DescribeBudget", "budgets:ViewBudget", "budgets:ModifyBudget"],
      "Resource": "*"
    }
  ]
}
