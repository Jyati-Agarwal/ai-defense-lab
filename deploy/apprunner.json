{
  "schema_version": 1,
  "service_name": "ai-defense-lab",
  "ecr_repository": "ai-defense-lab",
  "local_image": "ai-defense-lab:app-runner",
  "platform": "linux/amd64",
  "container_port": 8000,
  "instance": {
    "cpu": "2 vCPU",
    "memory": "4 GB"
  },
  "health_check": {
    "protocol": "HTTP",
    "path": "/health",
    "interval_seconds": 10,
    "timeout_seconds": 5,
    "healthy_threshold": 1,
    "unhealthy_threshold": 5
  },
  "wait": {
    "operation_attempts": 180,
    "operation_interval_seconds": 10,
    "local_health_attempts": 180,
    "public_health_attempts": 30,
    "health_interval_seconds": 5
  }
}
